{
  "name": "openfusion-gui",
  "private": true,
  "version": "0.2.0",
  "description": "Source of the OpenFusion modeling app. `npm run build` writes openfusion/gui/static/app.js.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2020 --outfile=../openfusion/gui/static/app.js --legal-comments=linked",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=../openfusion/gui/static/app.js --watch",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "three": "0.160.0",
    "codemirror": "6.0.1",
    "@codemirror/lang-python": "6.1.6",
    "@codemirror/state": "6.4.1",
    "@codemirror/view": "6.26.3"
  },
  "devDependencies": {
    "esbuild": "0.21.5"
  },
  "type": "module"
}
